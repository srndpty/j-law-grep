# j-law-grep 環境変数サンプル。`cp .env.example .env` して使います。
# 値はローカル開発 (Docker compose) の既定です。用途別の推奨値はコメントを参照してください。
#   - dev          : 軽量検証。shards=1, JAVA_OPTS=1g に下げる
#   - prod-like    : DEBUG=0, REINDEX_TOKEN を設定
#   - full-corpus  : prod-like に加え BULK/timeout を引き上げる (下のコメント参照)

# --- Django ---
DJANGO_SECRET_KEY=replace-me
# dev 以外 (prod-like / full-corpus) では 0 にする
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- OpenSearch 接続 / index ---
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_INDEX=jlaw-current
OPENSEARCH_SCHEMA_VERSION=6
# dev は 1 で十分。フルコーパスは 4 (既定)
OPENSEARCH_NUMBER_OF_SHARDS=4

# --- タイムアウト (秒) ---
# full-corpus では検索/投入が重くなるため引き上げる: TIMEOUT=60, REQUEST=30, BULK=180
OPENSEARCH_TIMEOUT_SECONDS=30
OPENSEARCH_REQUEST_TIMEOUT_SECONDS=10
OPENSEARCH_BULK_TIMEOUT_SECONDS=60

# --- bulk 投入 / heap ---
# bulk request の最大バイト数。dev は 20MB (20971520) に下げてもよい
OPENSEARCH_BULK_MAX_BYTES=41943040
# heap。dev は -Xms1g -Xmx1g に下げる。.env が無い場合 compose は 1GB にフォールバック
OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g

# --- reindex API ---
# /reindex を有効化する場合に設定。prod-like / full-corpus では必ず値を入れる
REINDEX_TOKEN=
