{
  "law_id": "minpou",
  "law_name": "民法",
  "law_aliases": ["民法典"],
  "year_enforced": "2022",
  "articles": [
    {
      "article_no": "1",
      "heading": "第1条（基本原則）",
      "paragraphs": [
        {
          "paragraph_no": 1,
          "items": [
            {
              "item_no": null,
              "text": "私権は、公共の福祉に適合しなければならない。"
            }
          ]
        },
        {
          "paragraph_no": 2,
          "items": [
            {
              "item_no": null,
              "text": "権利の行使及び義務の履行は、信義に従い誠実に行わなければならない。"
            }
          ]
        },
        {
          "paragraph_no": 3,
          "items": [
            {
              "item_no": null,
              "text": "権利の濫用は、これを許さない。"
            }
          ]
        }
      ]
    },
    {
      "article_no": "2",
      "heading": "第2条（解釈の基準）",
      "paragraphs": [
        {
          "paragraph_no": 1,
          "items": [
            {
              "item_no": null,
              "text": "この法律は、個人の尊厳と両性の本質的平等を旨として、解釈しなければならない。"
            }
          ]
        }
      ]
    },
    {
      "article_no": "90",
      "heading": "第90条（公序良俗）",
      "paragraphs": [
        {
          "paragraph_no": 1,
          "items": [
            {
              "item_no": null,
              "text": "公の秩序又は善良の風俗に反する法律行為は、無効とする。"
            }
          ]
        }
      ]
    },
    {
      "article_no": "709",
      "heading": "第709条（不法行為による損害賠償）",
      "paragraphs": [
        {
          "paragraph_no": 1,
          "items": [
            {
              "item_no": null,
              "text": "故意又は過失によって他人の権利又は法律上保護される利益を侵害した者は、これによって生じた損害を賠償する責任を負う。"
            }
          ]
        }
      ]
    },
    {
      "article_no": "710",
      "heading": "第710条（財産以外の損害の賠償）",
      "paragraphs": [
        {
          "paragraph_no": 1,
          "items": [
            {
              "item_no": null,
              "text": "他人の身体、自由若しくは名誉を侵害した場合又は他人の財産権を侵害した場合のいずれであるかを問わず、前条の規定により損害賠償の責任を負う者は、財産以外の損害に対しても、その賠償をしなければならない。"
            }
          ]
        }
      ]
    },
    {
      "article_no": "711",
      "heading": "第711条（近親者に対する損害の賠償）",
      "paragraphs": [
        {
          "paragraph_no": 1,
          "items": [
            {
              "item_no": null,
              "text": "他人の生命を侵害した者は、被害者の父母、配偶者及び子に対しては、その財産権が侵害されなかった場合においても、損害の賠償をしなければならない。"
            }
          ]
        }
      ]
    }
  ]
}
