DJANGO_SECRET_KEY=dev-only-insecure-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
OPENSEARCH_HOST=http://opensearch:9200
OPENSEARCH_INDEX=jlaw-current
OPENSEARCH_SCHEMA_VERSION=5
OPENSEARCH_NUMBER_OF_SHARDS=1
OPENSEARCH_TIMEOUT_SECONDS=30
OPENSEARCH_REQUEST_TIMEOUT_SECONDS=10
OPENSEARCH_BULK_TIMEOUT_SECONDS=60
OPENSEARCH_BULK_MAX_BYTES=20971520
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
REINDEX_TOKEN=
